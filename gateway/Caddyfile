# Caddy gateway.
#
# Beteendet styrs av SITE_ADDRESS i .env:
#   * SITE_ADDRESS=https://aps.kund.se  → Caddy skaffar & förnyar Let's Encrypt-cert automatiskt
#                                         (kunddrift: TLS sköts i stacken, ingen extern proxy behövs)
#   * SITE_ADDRESS=:80                  → Caddy kör ren HTTP, ingen ACME. Låt din NPM/reverse proxy
#                                         terminera TLS och forwarda hit (labb-drift).
#
# TLS_EMAIL används av Let's Encrypt för kontoregistrering och utgångsvarningar.

{
	email {$TLS_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	# API (REST) och WebSocket → FastAPI
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws/* {
		reverse_proxy api:8000
	}

	# Allt annat → frontend SPA
	handle {
		reverse_proxy frontend:80
	}

	header {
		# HSTS skickas bara när Caddy själv termineral TLS (ignoreras ändå över ren HTTP)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
