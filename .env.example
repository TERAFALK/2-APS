# Kopiera till .env och fyll i. Committa ALDRIG .env.

# --- Gateway / TLS ---
# LABB bakom din Nginx Proxy Manager (via npm_proxy-nätet):
#   SITE_ADDRESS=:80
#   → I NPM: Forward Hostname/IP = aps-gateway, Port = 80, Scheme = http. NPM sköter certet.
#   → Inga host-portar behövs (ports är bortkommenterade i docker-compose.yml).
# KUNDDRIFT (Caddy skaffar & förnyar Let's Encrypt-cert automatiskt):
#   SITE_ADDRESS=https://aps.vanertekno.se
#   HTTP_PORT=80  och  HTTPS_PORT=443   (avkommentera ports: i docker-compose.yml)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# E-post som Let's Encrypt använder för kontoregistrering + varning innan cert går ut.
# Behövs bara vid kunddrift (SITE_ADDRESS=https://...). Ofarlig att lämna ifylld i labb.
TLS_EMAIL=drift@vanertekno.se

# --- Databas ---
POSTGRES_USER=aps
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aps
DATABASE_URL=postgresql+psycopg://aps:change-me-strong-password@db:5432/aps

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generera: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# --- App ---
ENVIRONMENT=production
FIRST_ADMIN_EMAIL=admin@vanertekno.se
FIRST_ADMIN_PASSWORD=change-me-admin-password
