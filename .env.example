# Kopiera till .env och fyll i. Committa ALDRIG .env.

# --- Gateway / TLS ---
DOMAIN=aps.vanertekno.se
TLS_EMAIL=drift@vanertekno.se

# --- Databas ---
POSTGRES_USER=aps
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aps
DATABASE_URL=postgresql+psycopg://aps:change-me-strong-password@db:5432/aps

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generera: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# --- App ---
ENVIRONMENT=production
FIRST_ADMIN_EMAIL=admin@vanertekno.se
FIRST_ADMIN_PASSWORD=change-me-admin-password
